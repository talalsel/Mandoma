@model IEnumerable<Inventory.Web.Models.Sale>
@{ViewData["Title"]="الفواتير";}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h3 class="mb-0">الفواتير</h3><a asp-action="Create" class="btn btn-primary">فاتورة جديدة</a></div>
<form method="get" class="card card-body mb-3">
  <div class="row g-2"><div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم الفاتورة أو اسم أو هاتف العميل"></div><div class="col-md-3"><select name="type" class="form-select"><option value="">كل أنواع الفواتير</option><option value="0" selected="@(ViewBag.Type?.Equals(Inventory.Web.Models.SaleType.Cash) == true)">فاتورة نقدية</option><option value="1" selected="@(ViewBag.Type?.Equals(Inventory.Web.Models.SaleType.Issue) == true)">أمر صرف</option><option value="2" selected="@(ViewBag.Type?.Equals(Inventory.Web.Models.SaleType.Draft) == true)">فاتورة مبدئية</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary w-100">بحث</button></div></div>
</form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>رقم الفاتورة</th><th>النوع</th><th>التاريخ</th><th>العميل</th><th>المستخدم</th><th>الإجمالي</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td class="fw-bold">@(string.IsNullOrEmpty(s.InvoiceNumber) ? s.Id.ToString() : s.InvoiceNumber)</td><td>@(s.Type == Inventory.Web.Models.SaleType.Cash ? "نقدية" : s.Type == Inventory.Web.Models.SaleType.Issue ? "أمر صرف" : "مبدئية")</td><td>@s.SoldAt.ToString("yyyy-MM-dd HH:mm")</td><td>@(string.IsNullOrWhiteSpace(s.CustomerName) ? "عميل نقدي" : s.CustomerName)</td><td>@s.User?.FullName</td><td>@s.Total.ToString("N2")</td><td><a asp-action="Print" asp-route-id="@s.Id" class="btn btn-sm btn-info" target="_blank">طباعة</a>@if(User.IsInRole("Admin") || s.Type == Inventory.Web.Models.SaleType.Draft){<a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning ms-1">تعديل</a>}@if(User.IsInRole("Admin") && s.Type != Inventory.Web.Models.SaleType.Draft){<form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline ms-1">@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger" onclick="return confirm('حذف الفاتورة وإعادة الأصناف للمخزون؟')">حذف</button></form>}</td></tr>}</tbody></table></div>
