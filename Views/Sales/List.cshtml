@model IEnumerable<Inventory.Web.Models.Sale>
@{ViewData["Title"]="الفواتير";}<div class="d-flex justify-content-between mb-3"><h3>فواتير المبيعات</h3><a asp-action="Create" class="btn btn-primary">فاتورة جديدة</a></div><table class="table table-striped"><thead><tr><th>رقم الفاتورة</th><th>التاريخ</th><th>المستخدم</th><th>الإجمالي</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Id</td><td>@s.SoldAt.ToString("yyyy-MM-dd HH:mm")</td><td>@s.User?.FullName</td><td>@s.Total.ToString("N2")</td><td><a asp-action="Print" asp-route-id="@s.Id" class="btn btn-sm btn-info" target="_blank">طباعة</a>@if(User.IsInRole("Admin")){<a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning ms-1">تعديل</a><form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline ms-1">@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger" onclick="return confirm('حذف الفاتورة وإعادة الأصناف للمخزون؟')">حذف</button></form>}</td></tr>}</tbody></table>
