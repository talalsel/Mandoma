@model Inventory.Web.Models.Sale
@{ViewData["Title"]="تعديل الفاتورة"; var products=(IEnumerable<Inventory.Web.Models.Product>)ViewBag.Products;}
<h3>تعديل الفاتورة رقم @(string.IsNullOrEmpty(Model.InvoiceNumber)?Model.Id.ToString():Model.InvoiceNumber)</h3>
<form method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id">
<div class="row g-3 mb-3"><div class="col-md-4"><label class="form-label">اسم العميل</label><input name="customerName" value="@Model.CustomerName" class="form-control"></div><div class="col-md-4"><label class="form-label">هاتف العميل</label><input name="customerPhone" value="@Model.CustomerPhone" class="form-control"></div><div class="col-md-4"><label class="form-label">الخصم</label><input name="discount" type="number" step="0.01" min="0" value="@Model.Discount" class="form-control"></div></div>
<table class="table table-bordered"><thead><tr><th>الصنف</th><th>الكمية</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><select name="productIds" class="form-select">@foreach(var p in products){<option value="@p.Id" selected="@(p.Id==item.ProductId)">@p.Name - المتوفر @p.Quantity</option>}</select></td><td><input name="quantities" type="number" min="1" value="@item.Quantity" class="form-control"></td></tr>}</tbody></table>
<div class="mb-3"><label class="form-label">ملاحظات</label><textarea name="notes" class="form-control">@Model.Notes</textarea></div><button class="btn btn-primary">حفظ التعديلات</button> <a asp-action="List" class="btn btn-secondary">رجوع</a></form>
