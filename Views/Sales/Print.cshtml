@model Inventory.Web.Models.Sale
@{ Layout=null; var title = Model.Type == Inventory.Web.Models.SaleType.Cash ? "فاتورة مبيعات نقدية" : Model.Type == Inventory.Web.Models.SaleType.Issue ? "أمر صرف مخزني" : "فاتورة مبدئية"; }
<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>@title - @Model.InvoiceNumber</title><style>body{font-family:'Segoe UI',Tahoma,sans-serif;background:#fff;color:#111;direction:rtl;width:210mm;margin:0 auto}.invoice{padding:15mm}.header{display:flex;justify-content:space-between;border-bottom:2px solid #222;padding-bottom:10px}.company{text-align:center}table{width:100%;border-collapse:collapse;margin-top:15px}th,td{border:1px solid #777;padding:7px;text-align:center}.totals{width:45%;margin-right:auto;margin-top:12px}.totals td{text-align:right}.actions{margin:12px;text-align:left}@@media print{.actions{display:none}body{width:auto}.invoice{padding:8mm}}</style></head>
<body><div class="actions"><button onclick="window.print()">طباعة الفاتورة</button></div><div class="invoice"><div class="header"><div><h2>@title</h2><div>رقم الفاتورة: @(string.IsNullOrEmpty(Model.InvoiceNumber) ? Model.Id.ToString() : Model.InvoiceNumber)</div><div>التاريخ: @Model.SoldAt.ToString("yyyy/MM/dd HH:mm")</div></div><div class="company"><h1>شركة سيليني</h1></div></div>
<div class="mt"><strong>العميل:</strong> @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "عميل نقدي" : Model.CustomerName) &nbsp; <strong>الهاتف:</strong> @Model.CustomerPhone</div>
<table><thead><tr><th>م</th><th>الصنف</th><th>الكمية</th><th>سعر الوحدة</th><th>الإجمالي</th></tr></thead><tbody>@{var i=1;decimal subtotal=0;}@foreach(var item in Model.Items){var line=item.UnitPrice*item.Quantity;subtotal+=line;<tr><td>@i</td><td>@item.Product?.Name</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N2")</td><td>@line.ToString("N2")</td></tr>i++;}</tbody></table>
<table class="totals"><tr><td>الإجمالي قبل الخصم</td><td>@subtotal.ToString("N2")</td></tr><tr><td>الخصم</td><td>@Model.Discount.ToString("N2")</td></tr><tr><td><strong>المبلغ المستحق</strong></td><td><strong>@Model.Total.ToString("N2")</strong></td></tr></table><div style="margin-top:15px"><strong>الملاحظات:</strong> @Model.Notes</div>@if(Model.Type == Inventory.Web.Models.SaleType.Draft){<div style="margin-top:12px;color:#555"><strong>هذه فاتورة مبدئية ولا تؤثر على المخزون.</strong></div>}<div style="margin-top:35px;text-align:center">شكراً لتعاملكم معنا</div></div></body></html>
