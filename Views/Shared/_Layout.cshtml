<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventory.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">نظام المخزون والمبيعات</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        @if (!User.IsInRole("StockOnly") || User.IsInRole("Admin") || User.IsInRole("Accountant")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Products" asp-action="Index">المخزون والأصناف</a></li> }
                        else { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Products" asp-action="Index">المخزون والأصناف</a></li> }
                        @if (!User.IsInRole("StockOnly") || User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Sales" asp-action="List">المبيعات والفواتير</a></li> }
                        @if (!User.IsInRole("StockOnly")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Customers" asp-action="Index">الزبائن</a></li> }
                        @if (User.IsInRole("Admin") || User.IsInRole("Accountant") || User.IsInRole("Cashier")) {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">المحاسبة</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Accounting" asp-action="Index">القيود المحاسبية</a></li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Accountant")) {
                                        <li><a class="dropdown-item" asp-controller="Accounting" asp-action="Accounts">شجرة الحسابات</a></li>
                                        <li><a class="dropdown-item" asp-controller="Accounting" asp-action="Ledger">دفتر الأستاذ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Accounting" asp-action="TrialBalance">ميزان المراجعة</a></li>
                                        <li><a class="dropdown-item" asp-controller="Accounting" asp-action="Expenses">المصروفات</a></li>
                                        <li><a class="dropdown-item" asp-action="Purchases" asp-controller="Accounting">المشتريات</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Users">المستخدمون والصلاحيات</a></li> }
                        <li class="nav-item ms-sm-auto"><span class="nav-link text-dark">@User.Identity?.Name</span></li>
                        <li class="nav-item"><a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">خروج</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Inventory.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
