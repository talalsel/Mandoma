@model IEnumerable<Inventory.Web.Models.Purchase>
@{ ViewData["Title"]="المشتريات"; }<div class="d-flex justify-content-between mb-3"><h3>المشتريات</h3><a asp-action="CreatePurchase" class="btn btn-primary">شراء جديد</a></div><table class="table table-striped"><thead><tr><th>رقم الفاتورة</th><th>المورد</th><th>التاريخ</th><th>الإجمالي</th><th>الحالة</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.InvoiceNumber</td><td>@p.SupplierName</td><td>@p.PurchaseDate.ToString("yyyy-MM-dd")</td><td>@p.Total.ToString("N2")</td><td>@(p.IsPaid?"مدفوعة":"آجل")</td></tr>}</tbody></table>
