@model IEnumerable<Inventory.Web.Models.JournalLine>
@{ ViewData["Title"]="دفتر الأستاذ"; var accounts=(IEnumerable<Inventory.Web.Models.Account>)ViewBag.Accounts; }
<h3>دفتر الأستاذ</h3><form method="get" class="row mb-3"><div class="col-md-4"><select name="accountId" class="form-select"><option value="">كل الحسابات</option>@foreach(var a in accounts){<option value="@a.Id">@a.Code - @a.Name</option>}</select></div><div class="col-md"><button class="btn btn-primary">عرض</button></div></form><table class="table table-bordered"><thead><tr><th>التاريخ</th><th>القيد</th><th>الحساب</th><th>البيان</th><th>مدين</th><th>دائن</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.JournalEntry?.EntryDate.ToString("yyyy-MM-dd")</td><td>@l.JournalEntry?.Number</td><td>@l.Account?.Code - @l.Account?.Name</td><td>@l.Description</td><td>@l.Debit.ToString("N2")</td><td>@l.Credit.ToString("N2")</td></tr>}</tbody></table>
