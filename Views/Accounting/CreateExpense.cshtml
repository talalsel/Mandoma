@model Inventory.Web.Models.Expense
@{ ViewData["Title"]="إضافة مصروف"; var accounts=(IEnumerable<Inventory.Web.Models.Account>)ViewBag.Accounts; }<h3>إضافة مصروف</h3><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label class="form-label">التاريخ</label><input asp-for="ExpenseDate" type="date" class="form-control"></div><div class="col-md-4"><label class="form-label">الحساب</label><select asp-for="ExpenseAccountId" class="form-select">@foreach(var a in accounts){<option value="@a.Id">@a.Code - @a.Name</option>}</select></div><div class="col-md-4"><label class="form-label">المبلغ</label><input asp-for="Amount" type="number" step="0.01" class="form-control"></div><div class="col-md-12"><label class="form-label">البيان</label><input asp-for="Description" class="form-control"></div></div><button class="btn btn-primary mt-3">حفظ وترحيل</button> <a asp-action="Expenses" class="btn btn-secondary mt-3">رجوع</a></form>
