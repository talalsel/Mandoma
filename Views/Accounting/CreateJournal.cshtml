@model Inventory.Web.Models.JournalEntry
@{ ViewData["Title"] = "إضافة قيد يومي"; var accounts=(IEnumerable<Inventory.Web.Models.Account>)ViewBag.Accounts; }
<h3>إضافة قيد يومي</h3><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Number" class="form-label">رقم القيد</label><input asp-for="Number" class="form-control"></div><div class="col-md-4"><label asp-for="EntryDate" class="form-label">التاريخ</label><input asp-for="EntryDate" type="date" class="form-control"></div><div class="col-md-4"><label asp-for="Description" class="form-label">البيان</label><input asp-for="Description" class="form-control"></div></div><h5 class="mt-4">تفاصيل القيد</h5><table class="table" id="lines"><thead><tr><th>الحساب</th><th>مدين</th><th>دائن</th></tr></thead><tbody><tr><td><select name="accountIds" class="form-select">@foreach(var a in accounts){<option value="@a.Id">@a.Code - @a.Name</option>}</select></td><td><input name="debits" type="number" step="0.01" value="0" class="form-control"></td><td><input name="credits" type="number" step="0.01" value="0" class="form-control"></td></tr><tr><td><select name="accountIds" class="form-select">@foreach(var a in accounts){<option value="@a.Id">@a.Code - @a.Name</option>}</select></td><td><input name="debits" type="number" step="0.01" value="0" class="form-control"></td><td><input name="credits" type="number" step="0.01" value="0" class="form-control"></td></tr></tbody></table><button class="btn btn-primary">ترحيل القيد</button> <a asp-action="Index" class="btn btn-secondary">رجوع</a></form>
