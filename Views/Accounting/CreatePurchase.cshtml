@model Inventory.Web.Models.Purchase
@{ ViewData["Title"]="إضافة مشتريات"; }<h3>إضافة مشتريات</h3><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label class="form-label">رقم الفاتورة</label><input asp-for="InvoiceNumber" class="form-control"></div><div class="col-md-4"><label class="form-label">المورد</label><input asp-for="SupplierName" class="form-control"></div><div class="col-md-4"><label class="form-label">التاريخ</label><input asp-for="PurchaseDate" type="date" class="form-control"></div><div class="col-md-6"><label class="form-label">الإجمالي</label><input asp-for="Total" type="number" step="0.01" class="form-control"></div><div class="col-md-6"><div class="form-check mt-4"><input asp-for="IsPaid" class="form-check-input"><label class="form-check-label">فاتورة مدفوعة نقدًا</label></div></div></div><button class="btn btn-primary mt-3">حفظ وترحيل</button> <a asp-action="Purchases" class="btn btn-secondary mt-3">رجوع</a></form>
