@model IEnumerable<Inventory.Web.Models.Account>
@{ ViewData["Title"]="شجرة الحسابات"; }<div class="d-flex justify-content-between mb-3"><h3>شجرة الحسابات</h3><a asp-action="CreateAccount" class="btn btn-primary">حساب جديد</a></div><table class="table table-striped"><thead><tr><th>الرمز</th><th>اسم الحساب</th><th>النوع</th><th>الحالة</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Code</td><td>@a.Name</td><td>@(a.Type.ToString() switch { "Asset"=>"أصول", "Liability"=>"خصوم", "Equity"=>"حقوق ملكية", "Revenue"=>"إيرادات", "Expense"=>"مصروفات", _=>a.Type.ToString() })</td><td>@(a.IsActive?"نشط":"معطل")</td></tr>}</tbody></table>
