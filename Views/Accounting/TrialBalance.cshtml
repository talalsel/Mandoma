@model IEnumerable<dynamic>
@{ ViewData["Title"]="ميزان المراجعة"; decimal td=0, tc=0; }<h3>ميزان المراجعة</h3><table class="table table-bordered"><thead><tr><th>رمز الحساب</th><th>الحساب</th><th>مدين</th><th>دائن</th><th>الرصيد</th></tr></thead><tbody>@foreach(dynamic x in Model){var balance=(decimal)x.Debit-(decimal)x.Credit; td+=(decimal)x.Debit; tc+=(decimal)x.Credit;<tr><td>@x.Code</td><td>@x.Name</td><td>@(((decimal)x.Debit).ToString("N2"))</td><td>@(((decimal)x.Credit).ToString("N2"))</td><td>@balance.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="2">الإجمالي</th><th>@td.ToString("N2")</th><th>@tc.ToString("N2")</th><th></th></tr></tfoot></table>
