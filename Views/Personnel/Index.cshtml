@model IEnumerable<Inventory.Web.Models.Employee>
@{ ViewData["Title"] = "شؤون الموظفين"; }
<h2>شؤون الموظفين</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<div class="row mb-3"><div class="col-md-4"><div class="card"><div class="card-body"><b>الموظفون النشطون</b><h3>@ViewBag.TotalEmployees</h3></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><b>الحضور اليوم</b><h3>@ViewBag.PresentToday</h3></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><b>خصومات الشهر</b><h3>@(((decimal)ViewBag.MonthDeductions).ToString("N2"))</h3></div></div></div></div>
<div class="d-flex gap-2 mb-3"><a asp-action="Create" class="btn btn-primary">إضافة موظف</a><a asp-action="Attendance" class="btn btn-success">الحضور والغياب</a><a asp-action="Deductions" class="btn btn-warning">الخصومات</a></div>
<form method="get" class="mb-3"><div class="input-group"><input name="search" class="form-control" placeholder="بحث بالاسم أو الرقم أو الوظيفة"><button class="btn btn-outline-primary">بحث</button></div></form>
<div class="table-responsive"><table class="table table-bordered table-striped"><thead><tr><th>الرقم الوظيفي</th><th>الاسم</th><th>الوظيفة</th><th>القسم</th><th>المكان</th><th>الهاتف</th><th>الراتب الأساسي</th><th></th></tr></thead><tbody>@foreach (var e in Model) { <tr><td>@e.EmployeeNumber</td><td>@e.FullName</td><td>@e.JobTitle</td><td>@e.Department</td><td>@e.Branch?.Name</td><td>@e.Phone</td><td>@(User.IsInRole("Admin") || User.IsInRole("Accountant") ? e.BaseSalary.ToString("N2") : "مقيد")</td><td><a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">تعديل</a> <a asp-action="Attendance" asp-route-employeeId="@e.Id" class="btn btn-sm btn-outline-success">الحضور</a></td></tr> }</tbody></table></div>
