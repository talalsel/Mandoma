@model Inventory.Web.Models.Employee
@{ ViewData["Title"] = "تعديل بيانات الموظف"; var branches = ViewBag.Branches as IEnumerable<Inventory.Web.Models.Branch>; var users = ViewBag.Users as IEnumerable<Inventory.Web.Models.UserAccount>; bool canEditSalary = ViewBag.CanEditSalary; }
<h2>تعديل بيانات الموظف</h2><div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post"><div class="row g-3"><div class="col-md-3"><label asp-for="EmployeeNumber" class="form-label">الرقم الوظيفي</label><input asp-for="EmployeeNumber" class="form-control" required></div><div class="col-md-5"><label asp-for="FullName" class="form-label">اسم الموظف</label><input asp-for="FullName" class="form-control" required></div><div class="col-md-4"><label asp-for="NationalId" class="form-label">الرقم الوطني</label><input asp-for="NationalId" class="form-control"></div><div class="col-md-4"><label asp-for="Phone" class="form-label">الهاتف</label><input asp-for="Phone" class="form-control"></div><div class="col-md-4"><label asp-for="Email" class="form-label">البريد الإلكتروني</label><input asp-for="Email" class="form-control"></div><div class="col-md-4"><label asp-for="HireDate" class="form-label">تاريخ التعيين</label><input asp-for="HireDate" class="form-control" type="date"></div><div class="col-md-4"><label asp-for="JobTitle" class="form-label">المسمى الوظيفي</label><input asp-for="JobTitle" class="form-control"></div><div class="col-md-4"><label asp-for="Department" class="form-label">القسم</label><input asp-for="Department" class="form-control"></div><div class="col-md-4"><label asp-for="BranchId" class="form-label">المعرض / المخزن</label><select asp-for="BranchId" class="form-select"><option value="">بدون مكان</option>@foreach(var b in branches ?? Enumerable.Empty<Inventory.Web.Models.Branch>()) { <option value="@b.Id">@b.Name</option> }</select></div><div class="col-md-5"><label asp-for="UserAccountId" class="form-label">ربط حساب مستخدم</label><select asp-for="UserAccountId" class="form-select"><option value="">بدون حساب</option>@foreach(var u in users ?? Enumerable.Empty<Inventory.Web.Models.UserAccount>()) { <option value="@u.Id">@u.FullName (@u.Username)</option> }</select></div>@if (canEditSalary) { <div class="col-md-3"><label asp-for="BaseSalary" class="form-label">الراتب الأساسي</label><input asp-for="BaseSalary" class="form-control" type="number" step="0.01" min="0"></div><div class="col-md-4"><label asp-for="BankAccount" class="form-label">حساب البنك</label><input asp-for="BankAccount" class="form-control"></div> } else { <div class="alert alert-info mt-3">تعديل الراتب الأساسي مقيد بالمحاسب ومدير النظام فقط.</div> }<div class="col-md-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input"><label asp-for="IsActive" class="form-check-label">موظف نشط</label></div></div></div><div class="mt-3"><button class="btn btn-primary">حفظ التعديلات</button> <a asp-action="Index" class="btn btn-secondary">رجوع</a></div></form>
