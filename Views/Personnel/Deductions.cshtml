@model IEnumerable<Inventory.Web.Models.EmployeeDeduction>
@{ ViewData["Title"] = "خصومات الموظفين"; var employees = ViewBag.Employees as IEnumerable<Inventory.Web.Models.Employee>; int? selectedId = ViewBag.SelectedEmployeeId; }
<h2>خصومات الموظفين</h2><a asp-action="Index" class="btn btn-secondary mb-3">رجوع إلى الموظفين</a>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@if (ViewBag.CanManage == true) { <div class="card mb-3"><div class="card-body"><form method="post" asp-action="AddDeduction" class="row g-2"><div class="col-md-3"><label class="form-label">الموظف</label><select name="employeeId" class="form-select" required><option value="">اختر الموظف</option>@foreach(var e in employees ?? Enumerable.Empty<Inventory.Web.Models.Employee>()) { <option value="@e.Id">@e.FullName</option> }</select></div><div class="col-md-2"><label class="form-label">التاريخ</label><input name="deductionDate" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required></div><div class="col-md-2"><label class="form-label">المبلغ</label><input name="amount" type="number" step="0.01" min="0.01" class="form-control" required></div><div class="col-md-3"><label class="form-label">سبب الخصم</label><input name="reason" class="form-control" required></div><div class="col-md-2 align-self-end"><button class="btn btn-warning w-100">إضافة الخصم</button></div></form></div></div> }
<form method="get" class="mb-3"><select name="employeeId" class="form-select" onchange="this.form.submit()"><option value="">كل الموظفين</option>@foreach(var e in employees ?? Enumerable.Empty<Inventory.Web.Models.Employee>()) { <option value="@e.Id" selected="@(selectedId == e.Id)">@e.FullName</option> }</select></form>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>الموظف</th><th>التاريخ</th><th>المبلغ</th><th>السبب</th>@if (ViewBag.CanManage == true) { <th>الإجراء</th> }</tr></thead><tbody>@foreach(var d in Model) { <tr><td>@d.Employee?.FullName</td><td>@d.DeductionDate.ToString("yyyy-MM-dd")</td><td>@d.Amount.ToString("N2")</td><td>@d.Reason</td>@if (ViewBag.CanManage == true) { <td><form asp-action="DeleteDeduction" asp-route-id="@d.Id" method="post" onsubmit="return confirm('هل تريد حذف هذا الخصم؟');"><button class="btn btn-sm btn-danger">حذف</button></form></td> }</tr> }</tbody></table></div>
