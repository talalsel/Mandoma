@model IEnumerable<Inventory.Web.Models.EmployeeAttendance>
@{ ViewData["Title"] = "الحضور والغياب"; var employees = ViewBag.Employees as IEnumerable<Inventory.Web.Models.Employee>; var date = ViewBag.Date as string; int? selectedId = ViewBag.SelectedEmployeeId; }
<h2>الحضور والغياب</h2><a asp-action="Index" class="btn btn-secondary mb-3">رجوع إلى الموظفين</a>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2"><div class="col-md-5"><label class="form-label">الموظف</label><select name="employeeId" class="form-select"><option value="">كل الموظفين</option>@foreach(var e in employees ?? Enumerable.Empty<Inventory.Web.Models.Employee>()) { <option value="@e.Id" selected="@(selectedId == e.Id)">@e.FullName - @e.EmployeeNumber (@(e.Branch?.Name ?? "بدون مكان"))</option> }</select></div><div class="col-md-3"><label class="form-label">التاريخ</label><input name="date" type="date" value="@date" class="form-control"></div><div class="col-md-2 align-self-end"><button class="btn btn-primary w-100">عرض</button></div></form></div></div>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>الموظف</th><th>المكان</th><th>الحالة</th><th>الحضور</th><th>الانصراف</th><th>ملاحظات</th></tr></thead><tbody>@foreach(var e in employees ?? Enumerable.Empty<Inventory.Web.Models.Employee>()) { var row = Model.FirstOrDefault(x => x.EmployeeId == e.Id); <tr><form method="post" asp-action="SaveAttendance"><td>@e.FullName<input type="hidden" name="employeeId" value="@e.Id"><input type="hidden" name="date" value="@date"></td><td>@(e.Branch?.Name ?? "بدون مكان")</td><td><select name="status" class="form-select">@foreach(var s in Enum.GetValues<Inventory.Web.Models.AttendanceStatus>()) { var label = s switch { Inventory.Web.Models.AttendanceStatus.Present => "حاضر", Inventory.Web.Models.AttendanceStatus.Absent => "غائب", Inventory.Web.Models.AttendanceStatus.Leave => "إجازة", _ => "إجازة مرضية" }; <option value="@s" selected="@(row?.Status == s)">@label</option> }</select></td><td><input name="checkIn" type="time" class="form-control" value="@(row?.CheckIn?.ToString("hh\\:mm") ?? "")"></td><td><input name="checkOut" type="time" class="form-control" value="@(row?.CheckOut?.ToString("hh\\:mm") ?? "")"></td><td><input name="notes" class="form-control" value="@(row?.Notes ?? "")"><button class="btn btn-success btn-sm mt-1">حفظ</button></td></form></tr> } @if (Model.Count() == 0 && (employees?.Any() ?? false)) { } </tbody></table></div>
@if (TempData["Message"] != null) { <div class="alert alert-success mt-3">@TempData["Message"]</div> }
