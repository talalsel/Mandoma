@model IEnumerable<Inventory.Web.Models.EmployeeAttendance>
@{ ViewData["Title"] = "الحضور والغياب"; var employees = ViewBag.Employees as IEnumerable<Inventory.Web.Models.Employee>; var date = ViewBag.Date as string; int? selectedId = ViewBag.SelectedEmployeeId; }
<h2>الحضور والغياب</h2><a asp-action="Index" class="btn btn-secondary mb-3">رجوع إلى الموظفين</a>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2"><div class="col-md-5"><label class="form-label">الموظف</label><select name="employeeId" class="form-select"><option value="">كل الموظفين</option>@foreach(var e in employees ?? Enumerable.Empty<Inventory.Web.Models.Employee>()) { <option value="@e.Id" selected="@(selectedId == e.Id)">@e.FullName - @e.EmployeeNumber (@(e.Branch?.Name ?? "بدون مكان"))</option> }</select></div><div class="col-md-3"><label class="form-label">التاريخ</label><input name="date" type="date" value="@date" class="form-control"></div><div class="col-md-2 align-self-end"><button class="btn btn-primary w-100">عرض</button></div></form></div></div>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<div class="row g-3">
@foreach(var e in employees ?? Enumerable.Empty<Inventory.Web.Models.Employee>()) { var row = Model.FirstOrDefault(x => x.EmployeeId == e.Id); 
<div class="col-lg-6"><div class="card"><div class="card-body">
<form method="post" asp-action="SaveAttendance">
<div class="d-flex justify-content-between mb-2"><strong>@e.FullName</strong><span class="text-muted">@(e.Branch?.Name ?? "بدون مكان")</span></div>
<input type="hidden" name="employeeId" value="@e.Id"><input type="hidden" name="date" value="@date">
<div class="row g-2">
<div class="col-md-4"><label class="form-label">الحالة</label><select name="status" class="form-select">@foreach(var s in Enum.GetValues<Inventory.Web.Models.AttendanceStatus>()) { var label = s switch { Inventory.Web.Models.AttendanceStatus.Present => "حاضر", Inventory.Web.Models.AttendanceStatus.Absent => "غائب", Inventory.Web.Models.AttendanceStatus.Leave => "إجازة", _ => "إجازة مرضية" }; <option value="@s" selected="@(row?.Status == s)">@label</option> }</select></div>
<div class="col-md-4"><label class="form-label">الحضور</label><input name="checkIn" type="time" class="form-control" value="@(row?.CheckIn?.ToString("hh\\:mm") ?? "")"></div>
<div class="col-md-4"><label class="form-label">الانصراف</label><input name="checkOut" type="time" class="form-control" value="@(row?.CheckOut?.ToString("hh\\:mm") ?? "")"></div>
<div class="col-md-9"><label class="form-label">ملاحظات</label><input name="notes" class="form-control" value="@(row?.Notes ?? "")"></div>
<div class="col-md-3 align-self-end"><button class="btn btn-success w-100">حفظ</button></div>
</div></form></div></div></div>
}
</div>
