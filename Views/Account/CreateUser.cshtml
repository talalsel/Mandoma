@model Inventory.Web.Models.UserAccount
@{ ViewData["Title"] = "إنشاء مستخدم"; }
<h2>إنشاء مستخدم جديد</h2>
<form asp-action="CreateUser" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label">الاسم الكامل</label><input asp-for="FullName" class="form-control" required></div><div class="col-md-6"><label asp-for="Username" class="form-label">اسم المستخدم</label><input asp-for="Username" class="form-control" required></div><div class="col-md-6"><label class="form-label">كلمة المرور</label><input name="password" type="password" minlength="6" class="form-control" required></div><div class="col-md-6"><label asp-for="Role" class="form-label">الصلاحية</label><select asp-for="Role" class="form-select"><option value="Admin">مدير النظام</option><option value="Accountant">محاسب</option><option value="Cashier">أمين الصندوق</option><option value="StockOnly">أمين المخزن</option><option value="Sales">موظف مبيعات</option></select></div>
<div class="col-md-6"><label asp-for="BranchId" class="form-label">المعرض / المخزن</label><select asp-for="BranchId" class="form-select"><option value="">بدون معرض</option>@foreach(var b in ViewBag.Branches as IEnumerable<Inventory.Web.Models.Branch>){<option value="@b.Id">@b.Name</option>}</select></div><div class="col-md-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input"><label asp-for="IsActive" class="form-check-label">مستخدم نشط</label></div></div></div><div class="mt-3"><button class="btn btn-primary">إنشاء المستخدم</button> <a asp-action="Users" class="btn btn-secondary">رجوع</a></div></form>