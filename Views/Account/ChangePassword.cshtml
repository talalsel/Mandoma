@model Inventory.Web.Models.UserAccount
@{ ViewData["Title"] = "تغيير كلمة المرور"; }
<h2>تغيير كلمة مرور المستخدم</h2>
<div class="card"><div class="card-body">
<form asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">اسم المستخدم</label><input class="form-control" value="@Model.Username" disabled /></div>
    <div class="mb-3"><label class="form-label">كلمة المرور الجديدة</label><input name="newPassword" type="password" minlength="6" class="form-control" autocomplete="new-password" required /></div>
    <div class="mb-3"><label class="form-label">تأكيد كلمة المرور</label><input name="confirmPassword" type="password" minlength="6" class="form-control" autocomplete="new-password" required /></div>
    <button class="btn btn-primary">حفظ كلمة المرور الجديدة</button>
    <a asp-action="Users" class="btn btn-secondary">رجوع</a>
</form>
</div></div>
