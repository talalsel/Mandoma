@{ Layout = null; ViewData["Title"] = "تسجيل الدخول"; }
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>تسجيل الدخول</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><style>body{background:#eef2f7}.login-card{max-width:420px;margin:8vh auto}.card{border:0;border-radius:16px;box-shadow:0 12px 35px rgba(0,0,0,.08)}</style></head><body><div class="container"><div class="login-card card"><div class="card-body p-4"><h3 class="text-center mb-4">شركة سيليني</h3><form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><div asp-validation-summary="All" class="text-danger mb-3"></div><div class="mb-3"><label class="form-label">اسم المستخدم</label><input name="username" class="form-control form-control-lg" autocomplete="username" required autofocus></div><div class="mb-4"><label class="form-label">كلمة المرور</label><input name="password" type="password" class="form-control form-control-lg" autocomplete="current-password" required></div><button class="btn btn-primary btn-lg w-100">تسجيل الدخول</button></form></div></div></div></body></html>