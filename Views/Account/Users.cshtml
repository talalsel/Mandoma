@model IEnumerable<Inventory.Web.Models.UserAccount>
@{ ViewData["Title"] = "المستخدمون"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>المستخدمون</h2><a class="btn btn-primary" asp-action="CreateUser">إنشاء مستخدم</a></div>
<form method="get" class="mb-3"><input name="search" class="form-control" placeholder="بحث عن مستخدم"></form>
<table class="table table-striped"><thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الصلاحية</th><th>الحالة</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Username</td><td>@(u.Role == Inventory.Web.Models.UserRole.Admin ? "مدير" : u.Role == Inventory.Web.Models.UserRole.Sales ? "مبيعات" : "مخزون فقط")</td><td>@(u.IsActive ? "نشط" : "معطل")</td></tr>}</tbody></table>