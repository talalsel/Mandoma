@model Inventory.Web.Models.Product
@{ ViewData["Title"] = "إضافة صنف"; }
<h2>إضافة صنف جديد</h2>
<form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3"><div class="col-md-4"><label asp-for="Sku" class="form-label">رمز الصنف</label><input asp-for="Sku" class="form-control"><span asp-validation-for="Sku" class="text-danger"></span></div><div class="col-md-8"><label asp-for="Name" class="form-label">اسم الصنف</label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Category" class="form-label">الفئة</label><input asp-for="Category" class="form-control"></div><div class="col-md-3"><label asp-for="Cost" class="form-label">التكلفة</label><input asp-for="Cost" class="form-control" type="number" step="0.01"></div><div class="col-md-3"><label asp-for="Price" class="form-label">سعر البيع</label><input asp-for="Price" class="form-control" type="number" step="0.01"></div><div class="col-md-2"><label asp-for="Quantity" class="form-label">الكمية</label><input asp-for="Quantity" class="form-control" type="number"></div><div class="col-md-3"><label asp-for="MinQuantity" class="form-label">حد التنبيه</label><input asp-for="MinQuantity" class="form-control" type="number"></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">رجوع</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }