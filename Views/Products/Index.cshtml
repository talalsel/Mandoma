@model IEnumerable<Inventory.Web.Models.Product>
@{ ViewData["Title"] = "المخزون"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>المخزون والأصناف</h2><a class="btn btn-primary" asp-action="Create">إضافة صنف</a></div>
<form method="get" class="mb-3"><div class="input-group"><input name="search" class="form-control" placeholder="بحث بالاسم أو الكود"><button class="btn btn-outline-secondary">بحث</button></div></form>
<table class="table table-striped align-middle"><thead><tr><th>الكود</th><th>الصنف</th><th>الفئة</th><th>الكمية</th><th>سعر التكلفة</th><th>سعر البيع</th><th></th></tr></thead><tbody>
@foreach (var p in Model) { <tr class="@(p.Quantity <= p.MinQuantity ? "table-warning" : "")"><td>@p.Sku</td><td>@p.Name</td><td>@p.Category</td><td>@p.Quantity</td><td>@p.Cost.ToString("N2")</td><td>@p.Price.ToString("N2")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">تعديل</a></td></tr> }
</tbody></table>