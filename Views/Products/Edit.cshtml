@model Inventory.Web.Models.Product
@{ ViewData["Title"] = "تعديل صنف"; }
<h2>تعديل الصنف</h2>
<form asp-action="Edit" method="post"><input type="hidden" asp-for="Id"><div class="row g-3"><div class="col-md-4"><label asp-for="Sku" class="form-label">رمز الصنف</label><input asp-for="Sku" class="form-control"></div><div class="col-md-8"><label asp-for="Name" class="form-label">اسم الصنف</label><input asp-for="Name" class="form-control"></div><div class="col-md-4"><label asp-for="Category" class="form-label">الفئة</label><input asp-for="Category" class="form-control"></div><div class="col-md-3"><label asp-for="Cost" class="form-label">التكلفة</label><input asp-for="Cost" class="form-control" type="number" step="0.01"></div><div class="col-md-3"><label asp-for="Price" class="form-label">سعر البيع</label><input asp-for="Price" class="form-control" type="number" step="0.01"></div><div class="col-md-2"><label asp-for="Quantity" class="form-label">الكمية</label><input asp-for="Quantity" class="form-control" type="number"></div><div class="col-md-3"><label asp-for="MinQuantity" class="form-label">حد التنبيه</label><input asp-for="MinQuantity" class="form-control" type="number"></div></div><div class="mt-3"><button class="btn btn-primary">حفظ التعديل</button> <a asp-action="Index" class="btn btn-secondary">رجوع</a></div></form>